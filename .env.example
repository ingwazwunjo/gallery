# Copy to .env.local and fill in. Never commit .env.local.

# --- Web app (Next.js) ---
# Local stack: values printed by `npx supabase start` / `npx supabase status`.
# Hosted project: https://owjdwfisygqsbcvcmvoz.supabase.co and its publishable key
# (Supabase dashboard → Project Settings → API Keys). Both are public by design.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=

# --- Local Supabase stack only (read by supabase/config.toml) ---
# Google OAuth client (D5). The client ID is public; the secret is not.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=673489849798-0iaph9vrq9b2e6f8pgi53hud28b17e1i.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
